{
  "entities": {
    "Patient": {
      "title": "Patient",
      "description": "Patient details and records.",
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["admitted", "discharged"]
        },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "fee": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["status", "name", "phone", "createdAt"]
    },
    "FinanceRecord": {
      "title": "Finance Record",
      "description": "Daily income, expenses, and market expenses.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["income", "clinic_expense", "market_expense"]
        },
        "amount": { "type": "number" },
        "description": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["type", "amount", "createdAt"]
    },
    "Staff": {
      "title": "Staff Member",
      "description": "Details of clinic staff.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "nationalId": { "type": "string" },
        "address": { "type": "string" },
        "salary": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "phone", "createdAt"]
    },
    "Volunteer": {
      "title": "Volunteer",
      "description": "Details of clinic volunteers.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "nationalId": { "type": "string" },
        "address": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "phone", "createdAt"]
    },
    "Admin": {
      "title": "Administrator",
      "description": "Admin access records.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "createdAt"]
    }
  },
  "firestore": {
    "/patients/{patientId}": {
      "schema": { "$ref": "#/entities/Patient" },
      "description": "Collection of all patients."
    },
    "/finances/{recordId}": {
      "schema": { "$ref": "#/entities/FinanceRecord" },
      "description": "Collection of financial records."
    },
    "/staff/{staffId}": {
      "schema": { "$ref": "#/entities/Staff" },
      "description": "Collection of staff members."
    },
    "/volunteers/{volunteerId}": {
      "schema": { "$ref": "#/entities/Volunteer" },
      "description": "Collection of volunteers."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/Admin" },
      "description": "Collection of admins."
    }
  }
}
